        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Load datasets\n",
        "sent = pd.read_csv(\"/content/fear_greed_index.csv\")\n",
        "trades = pd.read_csv(\"/content/historical_data.csv\")\n",
        "\n",
        "# Convert dates\n",
        "sent['date'] = pd.to_datetime(sent['date'], errors='coerce').dt.date\n",
        "trades['Timestamp IST'] = pd.to_datetime(trades['Timestamp IST'], errors='coerce').dt.date\n",
        "\n",
        "# Merge on date\n",
        "merged = pd.merge(\n",
        "    trades[['Closed PnL', 'Timestamp IST', 'Side']],\n",
        "    sent[['date', 'classification']],\n",
        "    left_on='Timestamp IST', right_on='date',\n",
        "    how='left'\n",
        ")\n",
        "\n",
        "# Summary by sentiment\n",
        "summary = merged.groupby('classification').agg(\n",
        "    trades_count=('Closed PnL', 'count'),\n",
        "    mean_pnl=('Closed PnL', 'mean'),\n",
        "    winrate=('Closed PnL', lambda x: (x > 0).mean())\n",
        ").reset_index()\n",
        "\n",
        "# Visualization: Average PnL\n",
        "sns.barplot(x='classification', y='mean_pnl', data=summary, palette='viridis')\n",
        "plt.title('Average PnL by Market Sentiment')\n",
        "plt.ylabel('Average PnL')\n",
        "plt.xlabel('Market Sentiment')\n",
        "plt.xticks(rotation=30)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Visualization: Winrate\n",
        "sns.barplot(x='classification', y='winrate', data=summary, palette='coolwarm')\n",
        "plt.title('Winrate by Market Sentiment')\n",
        "plt.ylabel('Winrate (%)')\n",
        "plt.xlabel('Market Sentiment')\n",
        "plt.gca().yaxis.set_major_formatter(plt.FuncFormatter(lambda y, _: '{:.0%}'.format(y)))\n",
        "plt.xticks(rotation=30)\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
      ]
    }
